# Connection string do Postgres do Supabase.
# No painel do Supabase: Project Settings > Database > Connection string (URI).
# Use a porta 5432 (conexão direta) ou 6543 (pooler), conforme o que seu
# projeto Supabase oferecer.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# URLs base das APIs. Os valores abaixo já são os padrões usados pelo
# pipeline se essas variáveis não forem definidas — só sobrescreva se
# precisar apontar para outro ambiente.
TCE_BASE_URL=https://api-dados-abertos.tce.ce.gov.br/sim
OPENCNPJ_BASE_URL=https://api.opencnpj.org
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades

# UF processada pelo pipeline.
UF_ALVO=CE

# Quantos registros por página nas chamadas ao TCE-CE (limite da API é 1000).
TCE_PAGE_SIZE=1000

# Timeout de cada chamada HTTP, em segundos.
HTTP_TIMEOUT_SEGUNDOS=30

# Por quantos dias um dado de empresa no cache (dim_empresa) é
# considerado válido antes de consultar o OpenCNPJ de novo.
OPENCNPJ_DIAS_VALIDADE_CACHE=30

# Consultas simultâneas ao OpenCNPJ. Aumente com cautela para não atingir rate limit.
OPENCNPJ_MAX_WORKERS=2
