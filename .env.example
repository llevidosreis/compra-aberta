# Connection string do Postgres do Supabase.
# No painel do Supabase: Project Settings > Database > Connection string (URI).
# Use a porta 5432 (conexão direta) ou 6543 (pooler), conforme o que seu
# projeto Supabase oferecer.
DATABASE_URL=

# URLs base das APIs.
TCE_BASE_URL=https://api-dados-abertos.tce.ce.gov.br/sim
OPENCNPJ_BASE_URL=https://api.opencnpj.org
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades

# UF processada pelo pipeline.
UF_ALVO=CE

# Quantos registros por página nas chamadas ao TCE-CE.
TCE_PAGE_SIZE=1000

# API de consulta do PNCP. Contratações aceita de 10 a 50 registros por página.
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1
PNCP_PAGE_SIZE=50
# Códigos padrão para dispensa e inexigibilidade; separados por vírgula.
PNCP_MODALIDADES=8,9
PNCP_LIMIAR_MATCH=0.35

# Timeout de cada chamada HTTP, em segundos.
HTTP_TIMEOUT_SEGUNDOS=30

# Validade do cache de empresas, em dias.
OPENCNPJ_DIAS_VALIDADE_CACHE=30

# Consultas simultâneas ao OpenCNPJ.
OPENCNPJ_MAX_WORKERS=2
